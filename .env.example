# Cadena de conexión de Neon (Postgres)
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require

# Contraseña para entrar al panel /#dashboard
ADMIN_PASSWORD=

# Texto aleatorio largo para firmar la sesión del dueño (mínimo 16 caracteres)
SESSION_SECRET=

# Opcional: activa el asesor con IA de Claude. Sin esta clave el asesor usa reglas fijas.
ANTHROPIC_API_KEY=
